rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pratibha Karanji & Kalotsava 2026-27 educational event rules
    // Enables multi-user collaboration between CRPs, School HMs, Judges, and BEO Admins
    match /users/{userId} {
      allow read, write: if true;
    }
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /judges/{judgeId} {
      allow read, write: if true;
    }
    match /scores/{scoreId} {
      allow read, write: if true;
    }
    match /clusters/{clusterId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
